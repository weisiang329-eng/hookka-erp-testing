+// ---------------------------------------------------------------------------
+// Active sessions — where this account is currently signed in.
+//
+// WHY THIS MATTERS MORE THAN IT LOOKS
+// The login log records authentications. With "Remember me" a session slides
+// for a week, so one login buys days of access and emits nothing further. An
+// account can therefore be in use daily while the login log shows a single
+// entry from last month. That gap is where a hijacked session, a shared
+// machine nobody signed out of, and an un-offboarded employee all hide.
+//
+// The account owner is the only person who can say "that is not me". This
+// gives them the list, in terms they can actually judge — a device they
+// recognise, a place, and when it was last used — plus a button.
+// ---------------------------------------------------------------------------
+type SessionRow = {
+  id: string | null;
+  device: string;
+  ipAddress: string | null;
+  createdAt: string;
+  lastSeenAt: string | null;
+  expiresAt: string;
+  current: boolean;
+};
+
+function timeAgo(iso: string | null): string {
+  if (!iso) return "unknown";
+  const ms = Date.now() - new Date(iso).getTime();
+  if (!Number.isFinite(ms)) return "unknown";
+  const m = Math.floor(ms / 60000);
+  if (m < 1) return "just now";
+  if (m < 60) return `${m} min ago`;
+  const h = Math.floor(m / 60);
+  if (h < 24) return `${h} hour${h === 1 ? "" : "s"} ago`;
+  const d = Math.floor(h / 24);
+  return `${d} day${d === 1 ? "" : "s"} ago`;
+}
+
+function ActiveSessions() {
+  const [rows, setRows] = useState<SessionRow[] | null>(null);
+  const [err, setErr] = useState<string | null>(null);
+  const [busy, setBusy] = useState<string | null>(null);
+
+  const load = useCallback(async () => {
+    try {
+      const res = await fetch("/api/sessions", { credentials: "include" });
+      const json = (await res.json()) as {
+        success?: boolean;
+        data?: SessionRow[];
+      };
+      if (!res.ok || !json.success) {
+        setErr("Could not load your sessions.");
+        return;
+      }
+      setRows(json.data ?? []);
+    } catch {
+      setErr("Network error.");
+    }
+  }, []);
+
+  useEffect(() => {
+    void load();
+  }, [load]);
+
+  async function revoke(id: string) {
+    setBusy(id);
+    try {
+      const res = await fetch(`/api/sessions/${encodeURIComponent(id)}`, {
+        method: "DELETE",
+        credentials: "include",
+      });
+      if (res.ok) await load();
+    } finally {
+      setBusy(null);
+    }
+  }
+
+  return (
+    <Card className="mt-6">
+      <CardHeader>
+        <CardTitle>Where you're signed in</CardTitle>
+        <CardDescription>
+          Every device with a live sign-in to your account. If you don't
+          recognise one — an unfamiliar device, place, or a time you weren't
+          working — sign it out and change your password.
+        </CardDescription>
+      </CardHeader>
+      <CardContent>
+        {err && <p className="text-sm text-red-600">{err}</p>}
+        {!rows && !err && (
+          <p className="text-sm text-muted-foreground">Checking…</p>
+        )}
+        {rows && rows.length === 0 && (
+          <p className="text-sm text-muted-foreground">
+            No other active sessions.
+          </p>
+        )}
+        {rows && rows.length > 0 && (
+          <div className="space-y-2">
+            {rows.map((r) => (
+              <div
+                key={r.id ?? r.createdAt}
+                className="flex items-center justify-between rounded border border-slate-200 dark:border-slate-800 p-3"
+              >
+                <div className="text-sm">
+                  <div className="font-medium">
+                    {r.device}
+                    {r.current && (
+                      <span className="ml-2 text-xs text-green-700 dark:text-green-400">
+                        This device
+                      </span>
+                    )}
+                  </div>
+                  <div className="text-muted-foreground text-xs mt-0.5">
+                    {r.ipAddress ?? "IP not recorded"} · last used{" "}
+                    {timeAgo(r.lastSeenAt)}
+                  </div>
+                </div>
+                {!r.current && r.id && (
+                  <Button
+                    variant="outline"
+                    disabled={busy === r.id}
+                    onClick={() => void revoke(r.id as string)}
+                  >
+                    {busy === r.id ? "Signing out…" : "Sign out"}
+                  </Button>
+                )}
+              </div>
+            ))}
+          </div>
+        )}
+      </CardContent>
