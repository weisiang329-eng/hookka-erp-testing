{
  "name": "hookka-mobile",
  "version": "1.0.0",
  "private": true,
  "description": "Capacitor iOS shells for the Hookka Worker Portal and Hookka ERP web apps. Deps live here so the ERP package.json and its Vite bundle stay untouched.",
  "scripts": {
    "sync:worker": "cap sync ios --config capacitor.worker.config.ts",
    "sync:erp": "cap sync ios --config capacitor.erp.config.ts",
    "add:worker": "cap add ios --config capacitor.worker.config.ts",
    "add:erp": "cap add ios --config capacitor.erp.config.ts"
  },
  "dependencies": {
    "@capacitor/app": "^6.0.0",
    "@capacitor/core": "^6.1.2",
    "@capacitor/device": "^6.0.0",
    "@capacitor/geolocation": "^6.0.0",
    "@capacitor/ios": "^6.1.2",
    "@capacitor/push-notifications": "^6.0.0",
    "@capacitor/splash-screen": "^6.0.0",
    "@capacitor/status-bar": "^6.0.0",
    "@capacitor-mlkit/barcode-scanning": "^6.1.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^6.1.2"
  }
}
