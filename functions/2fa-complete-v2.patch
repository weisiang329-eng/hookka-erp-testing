diff --git a/src/pages/login-verify.tsx b/src/pages/login-verify.tsx
new file mode 100644
index 00000000..c0c9dadb
--- /dev/null
+++ b/src/pages/login-verify.tsx
@@ -0,0 +1,286 @@
+// ---------------------------------------------------------------------------
+// Two-factor sign-in — step 2 of 2.
+//
+// THIS PAGE IS THE PIECE THAT WAS MISSING (BUG-2026-08-04-006).
+//
+// The backend for 2FA has been complete since Phase C.6: enrollment, QR codes,
+// TOTP verification, recovery codes and POST /api/auth/totp/login-verify all
+// exist and work. What never shipped was a screen where the operator types
+// their 6-digit code. Without it, /api/auth/login would answer
+// { totpRequired: true } and the flow simply stopped — which is why enrolling
+// in 2FA locked a SUPER_ADMIN out of his own account on 2026-08-04, and why
+// TOTP_LOGIN_ENFORCEMENT_ENABLED has been false ever since.
+//
+// Contract (see src/api/routes/auth-totp.ts):
+//   POST /api/auth/totp/login-verify
+//   body { userId, code, pendingToken, rememberMe }
+//   → 200 { success, data: { user, csrfToken } }  — session cookies set
+//   → 401 "Invalid credentials"                    — wrong code
+//   → 401 "That sign-in attempt timed out…"        — pendingToken older than 5m
+//   → 429                                          — 10 attempts / 15 min
+//
+// `code` may be a 6-digit TOTP or a recovery code; the server decides by shape.
+//
+// SECURITY NOTE — why this page takes its inputs from router state and not
+// from the URL or storage:
+//   `pendingToken` is the proof that the PASSWORD step succeeded. It is a
+//   short-lived bearer credential. Putting it in a query string would write it
+//   into browser history, Referer headers and any proxy log in between; putting
+//   it in localStorage would leave it readable by every script on the origin
+//   and outlive the five-minute window. react-router's location.state lives in
+//   memory only. A direct visit to /login-verify therefore has no state and is
+//   bounced back to /login — which is correct, not a bug.
+// ---------------------------------------------------------------------------
+import { useState, useEffect, useRef } from "react";
+import { useLocation, useNavigate, Link } from "react-router-dom";
+import { ShieldCheck, ArrowLeft, KeyRound, Loader2 } from "lucide-react";
+import { setAuth, type AuthUser } from "@/lib/auth";
+
+type HandoffState = {
+  userId: string;
+  pendingToken?: string;
+  rememberMe: boolean;
+  email?: string;
+};
+
+type VerifyResponse =
+  | { success: true; data: { user: AuthUser; csrfToken: string } }
+  | { success: false; error?: string };
+
+const CODE_LEN = 6;
+
+export default function LoginVerify() {
+  const navigate = useNavigate();
+  const location = useLocation();
+  const state = (location.state ?? null) as HandoffState | null;
+
+  // One box per digit — matches how every authenticator app presents the code
+  // and makes a mistyped digit obvious.
+  const [digits, setDigits] = useState<string[]>(Array(CODE_LEN).fill(""));
+  const [recoveryMode, setRecoveryMode] = useState(false);
+  const [recoveryCode, setRecoveryCode] = useState("");
+  const [error, setError] = useState<string | null>(null);
+  const [expired, setExpired] = useState(false);
+  const [loading, setLoading] = useState(false);
+  const inputsRef = useRef<Array<HTMLInputElement | null>>([]);
+
+  // No handoff state → someone navigated here directly, or refreshed the page
+  // (which discards in-memory state). Send them back to enter their password.
+  useEffect(() => {
+    if (!state?.userId) navigate("/login", { replace: true });
+  }, [state, navigate]);
+
+  useEffect(() => {
+    if (!recoveryMode) inputsRef.current[0]?.focus();
+  }, [recoveryMode]);
+
+  if (!state || !state.userId) return null;
+  // Narrowed once into a non-null const: TypeScript will not carry the guard
+  // above into the closures below, and `submit` reads it after an await.
+  const handoff: HandoffState = state;
+
+  const code = recoveryMode ? recoveryCode.trim() : digits.join("");
+  const ready = recoveryMode ? code.length > 0 : code.length === CODE_LEN;
+
+  function setDigit(i: number, raw: string) {
+    const v = raw.replace(/\D/g, "");
+    setError(null);
+    if (!v) {
+      setDigits((d) => d.map((x, j) => (j === i ? "" : x)));
+      return;
+    }
+    // Typing or pasting several digits at once fills forward from here.
+    setDigits((d) => {
+      const next = [...d];
+      for (let k = 0; k < v.length && i + k < CODE_LEN; k++) next[i + k] = v[k];
+      return next;
+    });
+    const land = Math.min(i + v.length, CODE_LEN - 1);
+    inputsRef.current[land]?.focus();
+  }
+
+  function onKeyDown(i: number, e: React.KeyboardEvent<HTMLInputElement>) {
+    if (e.key === "Backspace" && !digits[i] && i > 0) {
+      inputsRef.current[i - 1]?.focus();
+    }
+    if (e.key === "ArrowLeft" && i > 0) inputsRef.current[i - 1]?.focus();
+    if (e.key === "ArrowRight" && i < CODE_LEN - 1) inputsRef.current[i + 1]?.focus();
+  }
+
+  async function landingPage(): Promise<string> {
+    try {
+      const res = await fetch("/api/auth/me/permissions", { credentials: "include" });
+      const body = (await res.json()) as { home?: string };
+      if (body?.home) return body.home;
+    } catch {
+      /* fall through */
+    }
+    return "/settings";
+  }
+
+  async function submit(e?: React.FormEvent) {
+    e?.preventDefault();
+    if (!ready || loading) return;
+    setError(null);
+    setLoading(true);
+    try {
+      const res = await fetch("/api/auth/totp/login-verify", {
+        method: "POST",
+        headers: { "Content-Type": "application/json" },
+        credentials: "include",
+        body: JSON.stringify({
+          userId: handoff.userId,
+          code,
+          pendingToken: handoff.pendingToken,
+          rememberMe: handoff.rememberMe,
+        }),
+      });
+      const json = (await res.json()) as VerifyResponse;
+
+      if (!res.ok || !json.success) {
+        const msg =
+          ("error" in json && json.error) || "That code was not accepted.";
+        // The server deliberately distinguishes an expired attempt from a bad
+        // code — "start again" is actionable, and without it the operator goes
+        // hunting for a wrong password that was never wrong.
+        if (res.status === 401 && /timed out/i.test(msg)) setExpired(true);
+        setError(msg);
+        setDigits(Array(CODE_LEN).fill(""));
+        setRecoveryCode("");
+        inputsRef.current[0]?.focus();
+        return;
+      }
+
+      setAuth({ user: json.data.user, rememberMe: handoff.rememberMe });
+      navigate(await landingPage(), { replace: true });
+    } catch (err) {
+      setError(
+        err instanceof Error ? err.message : "Network error. Please try again.",
+      );
+    } finally {
+      setLoading(false);
+    }
+  }
+
+  // Auto-submit once the sixth digit lands — the code is only valid for ~30s,
+  // so making the operator reach for a button wastes part of the window.
+  useEffect(() => {
+    if (!recoveryMode && digits.every((d) => d) && !loading) void submit();
+    // eslint-disable-next-line react-hooks/exhaustive-deps
+  }, [digits.join("")]);
+
+  return (
+    <div className="min-h-screen flex items-center justify-center bg-slate-50 dark:bg-slate-950 px-4">
+      <div className="w-full max-w-md">
+        <div className="rounded-2xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 shadow-sm p-8">
+          <div className="flex flex-col items-center text-center mb-6">
+            <div className="h-12 w-12 rounded-full bg-amber-100 dark:bg-amber-950 flex items-center justify-center mb-4">
+              <ShieldCheck className="h-6 w-6 text-amber-700 dark:text-amber-400" />
+            </div>
+            <h1 className="text-xl font-semibold text-slate-900 dark:text-slate-100">
+              Two-factor sign-in
+            </h1>
+            <p className="text-sm text-slate-500 dark:text-slate-400 mt-1">
+              {recoveryMode
+                ? "Enter one of your recovery codes."
+                : "Enter the 6-digit code from your authenticator app."}
+            </p>
+            {handoff.email && (
+              <p className="text-xs text-slate-400 dark:text-slate-500 mt-2">
+                {handoff.email}
+              </p>
+            )}
+          </div>
+
+          <form onSubmit={submit}>
+            {recoveryMode ? (
+              <input
+                autoFocus
+                value={recoveryCode}
+                onChange={(e) => {
+                  setRecoveryCode(e.target.value);
+                  setError(null);
+                }}
+                placeholder="Recovery code"
+                aria-label="Recovery code"
+                disabled={loading || expired}
+                className="w-full rounded-lg border border-slate-300 dark:border-slate-700 bg-white dark:bg-slate-950 px-4 py-3 text-center font-mono tracking-widest text-slate-900 dark:text-slate-100 outline-none focus:ring-2 focus:ring-amber-500 disabled:opacity-50"
+              />
+            ) : (
+              <div className="flex justify-center gap-2" role="group" aria-label="6-digit code">
+                {digits.map((d, i) => (
+                  <input
+                    key={i}
+                    ref={(el) => { inputsRef.current[i] = el; }}
+                    value={d}
+                    onChange={(e) => setDigit(i, e.target.value)}
+                    onKeyDown={(e) => onKeyDown(i, e)}
+                    inputMode="numeric"
+                    autoComplete={i === 0 ? "one-time-code" : "off"}
+                    maxLength={CODE_LEN}
+                    aria-label={`Digit ${i + 1}`}
+                    disabled={loading || expired}
+                    className="h-14 w-12 rounded-lg border border-slate-300 dark:border-slate-700 bg-white dark:bg-slate-950 text-center text-2xl font-semibold text-slate-900 dark:text-slate-100 outline-none focus:ring-2 focus:ring-amber-500 disabled:opacity-50"
+                  />
+                ))}
+              </div>
+            )}
+
+            {error && (
+              <p role="alert" className="mt-4 text-sm text-red-600 dark:text-red-400 text-center">
+                {error}
+              </p>
+            )}
+
+            {expired ? (
+              <Link
+                to="/login"
+                replace
+                className="mt-6 flex items-center justify-center gap-2 w-full rounded-lg bg-amber-600 hover:bg-amber-700 px-4 py-3 text-white font-medium"
+              >
+                <ArrowLeft className="h-4 w-4" />
+                Start again
+              </Link>
+            ) : (
+              <button
+                type="submit"
+                disabled={!ready || loading}
+                className="mt-6 flex items-center justify-center gap-2 w-full rounded-lg bg-amber-600 hover:bg-amber-700 disabled:opacity-40 disabled:cursor-not-allowed px-4 py-3 text-white font-medium"
+              >
+                {loading && <Loader2 className="h-4 w-4 animate-spin" />}
+                {loading ? "Verifying…" : "Verify"}
+              </button>
+            )}
+          </form>
+
+          {!expired && (
+            <button
+              type="button"
+              onClick={() => {
+                setRecoveryMode((m) => !m);
+                setError(null);
+                setDigits(Array(CODE_LEN).fill(""));
+                setRecoveryCode("");
+              }}
+              className="mt-4 flex items-center justify-center gap-2 w-full text-sm text-slate-500 hover:text-slate-800 dark:text-slate-400 dark:hover:text-slate-200"
+            >
+              <KeyRound className="h-3.5 w-3.5" />
+              {recoveryMode
+                ? "Use my authenticator app instead"
+                : "I've lost my authenticator — use a recovery code"}
+            </button>
+          )}
+
+          <Link
+            to="/login"
+            replace
+            className="mt-6 flex items-center justify-center gap-1.5 text-sm text-slate-400 hover:text-slate-600 dark:hover:text-slate-300"
+          >
+            <ArrowLeft className="h-3.5 w-3.5" />
+            Back to sign in
+          </Link>
+        </div>
+      </div>
+    </div>
+  );
+}
