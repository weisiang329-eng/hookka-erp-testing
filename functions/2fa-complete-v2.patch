+                  Enter your password to confirm. This removes the second factor
+                  and invalidates your recovery codes.
+                </p>
+                <Input
+                  type="password"
+                  autoComplete="current-password"
+                  value={password}
+                  onChange={(e) => setPassword(e.target.value)}
+                  placeholder="Your password"
+                  className="mb-2"
+                />
+                {disableError && (
+                  <p className="text-sm text-red-600 mb-2">{disableError}</p>
+                )}
+                <div className="flex gap-2">
+                  <Button type="submit" variant="destructive" disabled={busy}>
+                    {busy ? "Turning off…" : "Confirm"}
+                  </Button>
+                  <Button
+                    type="button"
+                    variant="outline"
+                    onClick={() => {
+                      setShowDisable(false);
+                      setPassword("");
+                      setDisableError(null);
+                    }}
+                  >
+                    Cancel
+                  </Button>
+                </div>
+              </form>
+            )}
+          </>
+        )}
+
+        {enabled === false && (
+          <>
+            <div className="flex items-center gap-2 mb-4">
+              <ShieldOff className="h-5 w-5 text-amber-600" />
+              <span className="font-medium">
+                Two-factor sign-in is off for your account.
+              </span>
+            </div>
+            <p className="text-sm text-muted-foreground mb-4">
+              You'll need an authenticator app — Google Authenticator, Microsoft
+              Authenticator, 1Password or Authy all work. Setup takes about a
+              minute, and you'll be given recovery codes to save in case you
+              lose your phone.
+            </p>
+            <Button onClick={() => navigate("/setup-2fa")}>
+              Set up two-factor sign-in
+            </Button>
+          </>
+        )}
+      </CardContent>
+    </Card>
+  );
+}
