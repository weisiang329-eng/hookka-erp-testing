+++ b/migrations-postgres/0231_session_accountability.sql
@@ -0,0 +1,38 @@
+-- ---------------------------------------------------------------------------
+-- 0231_session_accountability.sql — make a live session accountable.
+--
+-- user_sessions shipped with (token, user_id, created_at, expires_at): enough
+-- to validate a session, not enough to review one. With "Remember me" a single
+-- login grants days of sliding access and emits no further login events, so an
+-- account can be in daily use while the login log shows nothing since week one.
+-- An ex-employee on a remembered session, or a shared PC nobody signed out of,
+-- is invisible to a login-only view.
+--
+-- These four columns close that:
+--   id            — random public handle, so the API can address a session
+--                   without ever carrying its TOKEN (the actual credential)
+--   ip_address    — where it signed in from
+--   user_agent    — which browser/OS, so an owner recognises their own session
+--   last_seen_at  — when the account was last USED, not last authenticated.
+--                   This is what separates "dormant" from "has not retyped a
+--                   password lately" — the two are not the same, and treating
+--                   them as the same mislabels active users as abandoned.
+--
+-- All additive and idempotent. Mirrored by a runtime self-apply in
+-- src/api/lib/session-registry.ts, because the migration runner cannot be
+-- relied on to have run (CLAUDE.md).
+-- ---------------------------------------------------------------------------
+
+ALTER TABLE user_sessions ADD COLUMN IF NOT EXISTS id TEXT;
+ALTER TABLE user_sessions ADD COLUMN IF NOT EXISTS ip_address TEXT;
+ALTER TABLE user_sessions ADD COLUMN IF NOT EXISTS user_agent TEXT;
+ALTER TABLE user_sessions ADD COLUMN IF NOT EXISTS last_seen_at TEXT;
+
+-- Sessions created before this migration have no handle. Without one they
+-- would be the only sessions that cannot be listed or revoked — and the oldest
+-- sessions are exactly the ones worth reviewing.
+UPDATE user_sessions SET id = gen_random_uuid()::text WHERE id IS NULL;
+
+-- Listing is always "sessions for this user, most recently used first".
+CREATE INDEX IF NOT EXISTS idx_user_sessions_user_seen
+  ON user_sessions(user_id, last_seen_at DESC);
